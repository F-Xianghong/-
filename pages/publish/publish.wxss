page {
  background: #f2f7f9;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.compose {
  padding: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ph {
  color: #b8cdd4;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.img-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(35, 65, 77, 0.7);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #b8cdd4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.img-add-icon {
  font-size: 44rpx;
}

.img-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8aa5ad;
}

.topic-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef4f6;
}

.topic-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f0f6f8;
  color: #5b7a85;
  font-size: 24rpx;
}

.topic-chip.active {
  background: #e8f4f7;
  color: #166b8c;
  font-weight: 600;
}

.submit-btn {
  margin-top: 32rpx;
  padding: 20rpx 0;
}
