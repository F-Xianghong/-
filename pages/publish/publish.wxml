<view class="page">
  <view class="card compose">
    <textarea
      class="textarea"
      value="{{content}}"
      bindinput="onContent"
      placeholder="分享这片海上的故事…"
      placeholder-class="ph"
      maxlength="1000"
      auto-height
    />

    <!-- 已选图片 -->
    <view class="img-grid">
      <view wx:for="{{images}}" wx:key="*this" class="img-wrap">
        <image src="{{item}}" mode="aspectFill" class="img" bindtap="previewImage" data-url="{{item}}" />
        <view class="img-del" catchtap="removeImage" data-index="{{index}}">×</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="img-add" bindtap="chooseImage">
        <text class="img-add-icon">📷</text>
        <text class="img-add-text">添加图片</text>
      </view>
    </view>

    <!-- 话题 -->
    <view class="topic-row">
      <text
        wx:for="{{topics}}"
        wx:key="*this"
        class="topic-chip {{topicIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="pickTopic"
      ># {{item}}</text>
    </view>
  </view>

  <button class="primary-btn submit-btn" bindtap="submit">发布 🌊</button>
</view>
