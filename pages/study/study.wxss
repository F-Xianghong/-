.page {
  min-height: 100vh;
  padding: 24rpx;
}

/* 顶部说明 */
.banner {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
}

.banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 分类 */
.cat-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-row {
  display: inline-flex;
  gap: 16rpx;
}

.cat-chip {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5d7d88;
  background: #ffffff;
  border: 1rpx solid #e0ecf0;
  flex-shrink: 0;
}

.cat-chip.active {
  background: #166b8c;
  color: #ffffff;
  font-weight: 600;
  border-color: #166b8c;
}

/* 资料卡片 */
.material {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.head {
  display: flex;
  align-items: center;
}

.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.type-tag.video {
  background: #e8f4f7;
  color: #166b8c;
}

.type-tag.live {
  background: #f0ebfa;
  color: #7a5fc0;
}

.type-tag.article {
  background: #fff3e0;
  color: #e8862e;
}

.title {
  flex: 1;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #23414d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav {
  font-size: 36rpx;
  padding: 4rpx 8rpx;
}

.intro {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6d8b95;
  line-height: 1.6;
}

.foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.org {
  font-size: 24rpx;
  color: #5d7d88;
}

.meta {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8c0c8;
}

.free-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef4f6;
}

.free-tag {
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f7ee;
  color: #2ea86b;
  font-size: 20rpx;
}

.cat-tag {
  font-size: 22rpx;
  color: #8aa5ad;
}

/* 详情弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 45, 60, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  padding: 36rpx 32rpx 60rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  gap: 16rpx;
}

.sheet-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #23414d;
}

.sheet-intro {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6d8b95;
  line-height: 1.6;
}

.sheet-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8aa5ad;
}

.sheet-btn {
  margin-top: 32rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
}
