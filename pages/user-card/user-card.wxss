.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

/* 名片头部 */
.hero {
  position: relative;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 110rpx;
  background: linear-gradient(165deg, #6fbdea 0%, #3d9fd6 60%, #2f8fc7 100%);
  overflow: hidden;
}

/* 沙滩黄背景 */
.hero.beach {
  background: linear-gradient(165deg, #f2c14e 0%, #e8a23e 60%, #d98a2b 100%);
}

/* 自定义相册背景 */
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 45, 60, 0.45);
}

.hero-row {
  position: relative;
  z-index: 2;
}

.star {
  z-index: 2;
}

.bg-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 3;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.star {
  position: absolute;
  color: #ffe9a8;
}

.s1 { top: 40rpx; right: 60rpx; font-size: 40rpx; }
.s2 { top: 150rpx; right: 150rpx; font-size: 24rpx; opacity: 0.8; }
.s3 { bottom: 90rpx; right: 90rpx; font-size: 34rpx; opacity: 0.9; }

.hero-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  flex-shrink: 0;
}

.avatar.ph {
  background: linear-gradient(160deg, #eaf7fb, #bfe6f2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.hero-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.name-arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.85);
}

.cert-tag {
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.cert-tag.on {
  color: #7a5b12;
  background: #ffe9a8;
  border-color: #ffe9a8;
  font-weight: 600;
}

/* 徽章 */
.badge-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
}

.badge-count {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8aa5ad;
}

.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.badge {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  background: #f2f7f9;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.55;
}

.badge.earned {
  opacity: 1;
  background: #e8f4f7;
  border: 1rpx solid #b3dde6;
}

.badge.earned.monthly {
  background: linear-gradient(160deg, #fff6dd, #ffeec4);
  border-color: #ffe9a8;
}

.badge-emoji {
  font-size: 44rpx;
}

.badge-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #23414d;
  text-align: center;
}

.badge-desc {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #8aa5ad;
  text-align: center;
  line-height: 1.4;
}

.badge-month {
  margin-top: 6rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  color: #e8862e;
  background: #fff3e0;
}

.sig {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-go {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 16rpx;
}

.wave {
  position: absolute;
  left: -10%;
  width: 120%;
  height: 100rpx;
  border-radius: 100% 100% 0 0;
}

.w1 {
  bottom: -50rpx;
  background: rgba(255, 255, 255, 0.35);
}

.w2 {
  bottom: -70rpx;
  background: #f2f7f9;
}

/* 身份标签 */
.id-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 36rpx 8rpx 0;
}

.id-chip {
  display: flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #23414d;
  box-shadow: 0 4rpx 12rpx rgba(22, 107, 140, 0.08);
}

.id-chip.active {
  color: #166b8c;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(22, 107, 140, 0.18);
}

.id-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* 身份数据 */
.stats {
  display: flex;
  margin-top: 28rpx;
  padding: 32rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #eef4f6;
}

.stat:last-child {
  border-right: none;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #23414d;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8aa5ad;
}

/* 个人资料 */
.info-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx 8rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #23414d;
  margin-bottom: 8rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eef4f6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #23414d;
}

.info-label::after {
  content: '：';
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #23414d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-value.dim {
  color: #a8c0c8;
}

.info-arrow {
  margin-left: 16rpx;
  font-size: 34rpx;
  color: #b8cdd4;
}

/* 操作按钮 */
.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 28rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #23414d;
  font-size: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(22, 107, 140, 0.08);
}

/* 分享与联系 */
.share-bar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #57b2e3, #2f8fc7);
  overflow: hidden;
}

.share-half {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  background: transparent;
  line-height: 1.4;
}

.share-half::after {
  border: none;
}

.share-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.4);
}
