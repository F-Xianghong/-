page {
  background: #f2f7f9;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.group {
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eef4f6;
}

.row:last-child {
  border-bottom: none;
}

.row-info {
  flex: 1;
  min-width: 0;
  margin-right: 32rpx;
  display: flex;
  flex-direction: column;
}

.row-label {
  font-size: 30rpx;
  color: #23414d;
}

.row-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8c0c8;
}

.arrow {
  font-size: 36rpx;
  color: #b8cdd4;
}
