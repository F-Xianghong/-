.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

/* 考试说明 */
.exam-head {
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
}

.exam-title-row {
  display: flex;
  align-items: center;
}

.exam-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.timer {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffe9a8;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.timer.urgent {
  color: #ffffff;
  background: #d9534f;
  border-color: #d9534f;
}

.exam-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.exam-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.meta-chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 题目 */
.section-title {
  margin: 32rpx 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #23414d;
}

.section-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #a8c0c8;
}

.q-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.q-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #23414d;
  line-height: 1.5;
}

.q-score {
  font-size: 22rpx;
  font-weight: 400;
  color: #a8c0c8;
}

.q-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b8cdd4;
}

.option {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f5fafb;
  border: 1rpx solid #e0ecf0;
}

.option.selected {
  background: #e8f4f7;
  border-color: #166b8c;
}

.opt-letter {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #e0ecf0;
  color: #5d7d88;
  font-size: 24rpx;
  flex-shrink: 0;
}

.option.multi .opt-letter {
  border-radius: 10rpx;
}

.option.selected .opt-letter {
  background: #166b8c;
  color: #ffffff;
}

.opt-text {
  flex: 1;
  margin-left: 18rpx;
  font-size: 26rpx;
  color: #23414d;
}

/* 名词解释 */
.term-input {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f5fafb;
  border-radius: 16rpx;
  font-size: 26rpx;
  min-height: 140rpx;
  box-sizing: border-box;
}

.ph {
  color: #b8cdd4;
}

.submit-btn {
  margin-top: 40rpx;
  padding: 20rpx 0;
}

/* 成绩弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 45, 60, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.sheet {
  width: 82%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 40rpx 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.score-circle {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-circle.pass {
  background: linear-gradient(135deg, #35b978, #2ea86b);
}

.score-circle.fail {
  background: linear-gradient(135deg, #e89a4e, #e8862e);
}

.score-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4rpx;
}

.timeup-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8c0c8;
}

.score-verdict {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.score-verdict.pass {
  color: #2ea86b;
}

.score-verdict.fail {
  color: #e8862e;
}

.score-rows {
  margin-top: 24rpx;
}

.score-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef4f6;
  font-size: 26rpx;
  color: #5d7d88;
}

/* 错题分析 */
.analysis {
  margin-top: 24rpx;
  text-align: left;
}

.ana-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #23414d;
  margin-bottom: 12rpx;
}

.ana-perfect {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #2ea86b;
}

.ana-item {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f5fafb;
  border-left: 6rpx solid #e89a4e;
}

.ana-head {
  display: flex;
  align-items: flex-start;
}

.ana-type {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
}

.ana-type.single {
  background: #e8f4f7;
  color: #166b8c;
}

.ana-type.multi {
  background: #f0ebfa;
  color: #7a5fc0;
}

.ana-type.term {
  background: #fff3e0;
  color: #e8862e;
}

.ana-q {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #23414d;
  line-height: 1.5;
}

.ana-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.ana-your {
  font-size: 22rpx;
  color: #c96a6a;
}

.ana-correct {
  font-size: 22rpx;
  color: #2ea86b;
  margin-left: 16rpx;
}

.ana-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5d7d88;
  line-height: 1.5;
}

.ana-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a8c0c8;
}

.sheet-btn {
  margin-top: 32rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
}
