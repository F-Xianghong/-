.page {
  min-height: 100vh;
  padding: 24rpx;
}

/* 顶部概览 */
.overview {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.ov-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 56rpx;
}

.ov-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #166b8c;
}

.ov-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8aa5ad;
}

.ov-tip {
  width: 100%;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #a8c0c8;
}

/* 操作栏 */
.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tool-btn {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #166b8c;
  background: #ffffff;
  border: 1rpx solid #cfe6ec;
  border-radius: 16rpx;
}

/* 筛选 */
.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5d7d88;
  background: #ffffff;
  border: 1rpx solid #e0ecf0;
}

.tab.active {
  background: #166b8c;
  color: #ffffff;
  font-weight: 600;
  border-color: #166b8c;
}

/* 分组 */
.group {
  margin-bottom: 8rpx;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #23414d;
}

.group-count {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #a8c0c8;
}

.group-arrow {
  margin-left: auto;
  color: #8aa5ad;
  font-size: 28rpx;
  transition: transform 0.2s;
}

.group-arrow.fold {
  transform: rotate(-90deg);
}

/* 资料卡片 */
.record {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.record.highlight {
  border: 2rpx solid #7fc8d6;
  box-shadow: 0 4rpx 20rpx rgba(22, 107, 140, 0.12);
}

.record-head {
  display: flex;
  align-items: center;
}

.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.type-tag.result {
  background: #e8f4f7;
  color: #166b8c;
}

.type-tag.report {
  background: #fff3e0;
  color: #e8862e;
}

.type-tag.file {
  background: #f0ebfa;
  color: #7a5fc0;
}

.title {
  flex: 1;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #23414d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #e6f7ee;
  color: #2ea86b;
  font-size: 20rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.student {
  font-size: 24rpx;
  color: #5d7d88;
}

.date {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8c0c8;
}

.score {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #166b8c;
}

.summary {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8aa5ad;
  line-height: 1.6;
}

.actions {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef4f6;
}

.share-btn,
.preview-btn {
  margin: 0;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
  border-radius: 999rpx;
}

.share-btn::after,
.preview-btn::after {
  border: none;
}

.preview-btn {
  margin-right: 16rpx;
  background: #ffffff;
  color: #166b8c;
  border: 1rpx solid #b3dde6;
}

.more {
  margin-left: 16rpx;
  padding: 0 16rpx;
  font-size: 36rpx;
  color: #8aa5ad;
  line-height: 60rpx;
}

.vis-toggle {
  margin-left: auto;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #8aa5ad;
  background: #f2f7f9;
  border: 1rpx solid #e0ecf0;
}

.vis-toggle.on {
  color: #166b8c;
  background: #e8f4f7;
  border-color: #b3dde6;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 45, 60, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  padding: 36rpx 32rpx 60rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #23414d;
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef4f6;
}

.form-row.column {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #23414d;
  font-weight: 500;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.form-picker {
  font-size: 28rpx;
  color: #166b8c;
}

.form-textarea {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f5fafb;
  border-radius: 16rpx;
  font-size: 26rpx;
  min-height: 120rpx;
  box-sizing: border-box;
}

.ph {
  color: #b8cdd4;
}

.sheet-save {
  margin-top: 32rpx;
  padding: 18rpx 0;
  font-size: 30rpx;
}

/* 分组管理 */
.grp-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef4f6;
}

.grp-name {
  flex: 1;
  font-size: 28rpx;
  color: #23414d;
}

.grp-del {
  font-size: 24rpx;
  color: #e8862e;
  padding: 8rpx;
}

.grp-add {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.grp-input {
  flex: 1;
  padding: 18rpx 24rpx;
  background: #f5fafb;
  border-radius: 16rpx;
}

.grp-add-btn {
  margin-left: 20rpx;
  padding: 18rpx 36rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
}
