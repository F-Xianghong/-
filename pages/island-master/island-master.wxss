page {
  background: #f2f7f9;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 岛主状态栏 */
.master-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
}

.master-bar.sleep {
  background: linear-gradient(135deg, #5d7d88, #47616c);
}

.m-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.m-info {
  margin-left: 20rpx;
}

.m-name-row {
  display: flex;
  align-items: center;
}

.m-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.m-tag {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 20rpx;
}

.m-status {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 消息 */
.chat {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-pad {
  height: 20rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.m-mini {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #d8f0f4, #b3dde6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble.ai {
  background: #ffffff;
  color: #23414d;
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 107, 140, 0.06);
}

.bubble.user {
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
  color: #ffffff;
  border-top-right-radius: 8rpx;
}

/* 输入中动画 */
.typing {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 4rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b3dde6;
  animation: blink 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eef4f6;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: #f2f7f9;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.ph {
  color: #b8cdd4;
}

.send-btn {
  margin-left: 20rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1b7d9e, #166b8c);
  flex-shrink: 0;
}

.send-btn.off {
  opacity: 0.5;
}

.sleep-bar {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #8aa5ad;
}
